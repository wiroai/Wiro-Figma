{
  "//": "Tests of the UI modules run in Node with the DOM types; tests of the main thread use the Figma typings (tsconfig.test-main.json).",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "test/ui/**/*.ts",
    "test/live/**/*.ts",
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx",
    "src/ui/**/*.d.ts",
    "src/shared/**/*.ts"
  ]
}
