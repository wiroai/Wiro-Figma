{
  "//": "The main thread. Figma runs it in a sandbox, so the code sticks to ES2017 built-ins.",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@figma/plugin-typings"]
  },
  "include": ["src/code.ts", "src/main/**/*.ts", "src/shared/**/*.ts"]
}
